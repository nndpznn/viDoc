{
  "name": "vidoc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "bun pm cache rm && rm -rf .next",
    "clean:all": "rm -rf node_modules & rm bun.lock* & bun clean",
    "docs": "typedoc",
    "test": "jest --testPathPattern=src/.*?.unit.test.ts",
    "test:int": "jest --testPathPattern=src/.*?.int.test.ts",
    "test:all": "jest --testPathPattern=src/.*?.test.ts",
    "tc": "tsc --noEmit",
    "ci": "bun run test && bun run lint && bun run tc",
    "supa:login": "npx supabase login",
    "supa:types": "npx supabase gen types typescript --project-id hyjvoljjhtgnxxsdsxbh --schema public > src/types/supabase.database.types.ts",
    "supa:zod": "bun ts-to-zod src/types/supabase.database.custom.types.ts src/types/supabase.database.zod.types.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@fontsource/roboto": "^5.0.13",
    "@mui/icons-material": "6.5.0",
    "@mui/material": "6.5.0",
    "@react-oauth/google": "^0.12.1",
    "@supabase/supabase-js": "^2.43.4",
    "dotenv": "^16.4.5",
    "dotenv-expand": "^11.0.6",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "styled-components": "^6.1.11"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.36",
    "@testing-library/jest-dom": "^6.4.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.3",
    "typescript": "^5"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
